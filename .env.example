# ── 環境変数のキー名だけを置く。実値は絶対にコミットしない（spec 1-1）──

# ローカル開発DB（docker compose の Postgres+PostGIS）
# db-foundation が用意するローカル環境。既定値で動く。
# ローカルに別の Postgres が 5432 を使っている場合は DB_PORT を変えて衝突を回避する
# （例: DB_PORT=5433 なら DATABASE_URL も :5433 にする）。docker-compose がこの値を使う。
DB_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deli01"

# アプリのタイムゾーン（全処理 Asia/Tokyo。変更しない）
APP_TZ="Asia/Tokyo"

# ── 以下は発注者が用意するもの（停止条件②）。未設定でもローカル開発・CIは回る ──

# Supabase（管理側 Auth と本番/プレビューDB。開発は上の DATABASE_URL を使う）
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Google Maps Distance Matrix API（車のエリア間移動時間の初期一括生成。常時は叩かない / spec 5-1）
GOOGLE_MAPS_API_KEY=""

# OpenAI API（CMS内AIアシスタント / spec 19章。サーバー側のみ。クライアントに出さない）
# ※ spec 19章は Anthropic 記載だが、発注者判断で OpenAI に変更（README 判断ログ #6）
OPENAI_API_KEY=""

# メール送信（リマインド・週次レポート / spec 20章）。プロバイダ未定のためキー名のみ
EMAIL_FROM=""
SMTP_URL=""
